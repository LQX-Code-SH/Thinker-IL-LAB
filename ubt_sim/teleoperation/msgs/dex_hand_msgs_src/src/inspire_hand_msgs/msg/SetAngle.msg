# 因时 RH56 灵巧手 —— 关节角度指令（位置模式）
#
# 与厂商 xhumanoid_sdk 的接口定义一致：
#   hand_id: 预留，暂无实际用途（仿真桥接按话题分左右，不校验该字段）
#   joint_values[13]: 各自由度角度，单位 0.1 度（1200 = 120 度），每通道一个关节
#
#   通道  关节            范围         说明
#    0    小拇指指根      900-1650
#    1    无名指指根      900-1650
#    2    中指指根        900-1650
#    3    中指侧摆        -150-150
#    4    食指指根        900-1650
#    5    食指侧摆        -150-150
#    6    小拇指指中      1150-1900
#    7    无名指指中      1150-1900
#    8    中指指中        1150-1900
#    9    食指指中        1150-1900
#   10    大拇指侧摆      650-1750
#   11    大拇指一关节弯曲 1250-1600
#   12    大拇指二关节弯曲 1500-2040
#
# 屈曲通道码值越大越伸直（伸直在码上限），弯曲角 = (上限 - code) × 0.1°；
# 侧摆通道 0 为中立位，摆角 = code × 0.1°。
# 握拳示例（厂商 demo，指根 60° / 指中 75° / 拇指一关节 20° / 拇指二关节 54°）：
#   ros2 topic pub -r 30 /right_hand/angle_set inspire_hand_msgs/msg/SetAngle \
#     "{joint_values: [1051,1051,1051,0,1051,0,1150,1150,1150,1150,1500,1400,1500]}"
int32 hand_id
int32[13] joint_values
