<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ██ ██  ⚠️  机型相关，构建镜像前必改  ⚠️  ██ ██
  interfaceWhiteList 中第一个 <address> 是机器人直连网段，随机型切换：
    - 天工 Tienkung Pro:  192.168.41.99
    - Walker S2:          192.168.11.99
  构建前必须改成目标机型的网段，否则容器内收不到机器人话题。
  127.0.0.1 保留勿动。详见 docker/README.md「注意事项」第 3 条。
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>CustomUDPTransport</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList>
                <!-- ⚠️ 随机型切换：天工 192.168.41.99 / Walker S2 192.168.11.99（见文件头注释） -->
                <address>127.0.0.1</address>
                <!-- Walker C1（Thor 本体 mgbe2_0）：容器与主控同机，走 CycloneDDS 为主，此处为 FastDDS 兜底 -->
                <address>192.168.11.3</address>
                <address>192.168.11.99</address>
            </interfaceWhiteList>
            <maxInitialPeersRange>10</maxInitialPeersRange>
            <maxMessageSize>65500</maxMessageSize>
            <sendBufferSize>1048576</sendBufferSize>
            <receiveBufferSize>1048576</receiveBufferSize>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="CustomUDPTransportParticipant" is_default_profile="true">
        <rtps>
            <useBuiltinTransports>false</useBuiltinTransports>
            <userTransports>
                <transport_id>CustomUDPTransport</transport_id>
            </userTransports>
        </rtps>
    </participant>
</profiles>
